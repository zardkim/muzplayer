# muzplayer settings — copy to .env next to docker-compose.yml and fill in.

# Image tag to run (e.g. 0.1.0). "latest" follows the newest build.
MUZPLAYER_VERSION=latest

# Port on the NAS that the reverse proxy forwards to.
HTTP_PORT=8580

# Music library folder on the NAS. Symlinked folders (ln -s) and mounted shares inside it are scanned too.
MUSIC_PATH=/volume1/music

# Folder mounted read-only into the container, at the same path. Usually the same as MUSIC_PATH.
# If symlinks in the library point elsewhere (e.g. /volume1/other/...), use a parent that
# contains both, such as /volume1.
MUSIC_ROOT=/volume1/music

# Automatic rescan interval in minutes (picks up new/changed/deleted files). 0 = manual only.
SCAN_INTERVAL_MINUTES=60

# rprivate (default): shares mounted inside the library are seen after an app restart.
# rslave: seen immediately (requires the NAS mount to be shared; if the app fails to start, go back to rprivate).
MUSIC_MOUNT_PROPAGATION=rprivate

# Where the database and album-art cache are stored.
DATA_PATH=/volume1/docker/muzplayer/data

# User the app runs as (Synology: `id <user>` over SSH). Must be able to READ MUSIC_PATH.
PUID=1026
PGID=100

# Long random string. Do not change after the first start.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# First admin, created only when no users exist. Remove the password after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# UI language when the browser has not chosen one: ko or en.
DEFAULT_LOCALE=ko

# true behind HTTPS (normal). false only for plain http://NAS-IP:PORT testing.
COOKIE_SECURE=true

SESSION_DAYS=30
TZ=Asia/Seoul
