# muzplayer settings — copy to .env next to docker-compose.yml and fill in.
# The admin account, AI banner keys and YouTube key are set in the app, not here.

# Image tag to run. Default "latest" follows the newest build; pin a version (e.g. 0.8.0) to stay on it.
MUZPLAYER_VERSION=latest

# Folder that holds app/, db/, conf/ and library/ (absolute path; created on the first start).
# Mount the music to library/music (and audiobooks to library/audiobook), then restart the app.
MUZPLAYER_DIR=/volume1/docker/muzplayer

# Port on the NAS that the reverse proxy forwards to.
HTTP_PORT=18150

# User the app runs as (Synology: `id <user>` over SSH). Must be able to READ library/.
PUID=1026
PGID=100

# Long random string. Do not change after the first start.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Automatic rescan interval in minutes (picks up new/changed/deleted files). 0 = manual only.
SCAN_INTERVAL_MINUTES=60

# Converted songs (streaming quality, WMA/APE, levelling on iPhone) kept in app/transcode, in MB.
TRANSCODE_CACHE_MB=2048
# Another ffmpeg instead of the one in the image (it must have libmp3lame). Leave empty normally.
FFMPEG_PATH=

# UI language when the browser has not chosen one: ko or en.
DEFAULT_LOCALE=ko

# true behind HTTPS (normal). false only for plain http://NAS-IP:PORT testing.
COOKIE_SECURE=true

SESSION_DAYS=60
TZ=Asia/Seoul
